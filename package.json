{
  "name": "dishari-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Dishari (দিশারী) — Civic Tech Digital Government Assistant",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "seed": "pnpm --filter server seed",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
